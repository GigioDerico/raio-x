# Copie para .env.local e preencha. NUNCA commite o .env.local.
# O app se recusa a subir com valor de exemplo — ver src/env.ts.

# ── Banco (Neon) ─────────────────────────────────────────────────────────────
# Com pooler, usada pelas rotas:
DATABASE_URL=
# Direta (sem pooler), usada só pelas migrações:
DATABASE_URL_UNPOOLED=

# ── Sessão e senha única ─────────────────────────────────────────────────────
# Gere os dois com: npm run hash-senha
APP_PASSWORD_HASH=
SESSION_SECRET=

# ── Pluggy (fatia 4) ─────────────────────────────────────────────────────────
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Valida o POST em /api/webhook/pluggy
PLUGGY_WEBHOOK_SECRET=

# ── IA (fatia 2) ─────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_MODEL_FALLBACK=openai/gpt-4.1-mini
# Teto de gasto mensal em dólar. 0 = sem teto.
AI_BUDGET_USD_MONTH=10

# ── Cron (fatia 5) ───────────────────────────────────────────────────────────
# A Vercel injeta este valor no header do cron.
CRON_SECRET=
