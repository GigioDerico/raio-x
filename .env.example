# Copie para .env.local e preencha. NUNCA commite o .env.local.
# O app se recusa a subir com valor de exemplo — ver src/env.ts.

# ── Banco (Neon) ─────────────────────────────────────────────────────────────
# Com pooler, usada pelas rotas:
DATABASE_URL=
# Direta (sem pooler), usada só pelas migrações:
DATABASE_URL_UNPOOLED=

# ── Sessão e senha única ─────────────────────────────────────────────────────
# Gere os dois com: npm run hash-senha
APP_PASSWORD_HASH=
SESSION_SECRET=

# ── Pluggy (fatia 4) ─────────────────────────────────────────────────────────
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Valida o POST em /api/webhook/pluggy. Vazio: a rota não existe (404).
# 32+ caracteres; gere com: openssl rand -hex 32
PLUGGY_WEBHOOK_SECRET=

# ── IA multi-provedor (fatia 2) ──────────────────────────────────────────────
# Configure pelo assistente: npm run setup:ia
# Provedor ativo: 'openrouter' (padrão) | 'anthropic' | 'openai'
IA_PROVEDOR=openrouter
# Chaves (preencha a do seu provedor ativo):
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Modelos opcionais (se vazios, usam os padrões recomendados do provedor):
IA_MODEL=
IA_MODEL_FALLBACK=
# Retrocompatibilidade com OpenRouter:
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_MODEL_FALLBACK=openai/gpt-4.1-mini
# Teto de gasto mensal em dólar. 0 = sem teto.
AI_BUDGET_USD_MONTH=10

# ── Cron (fatia 5) ───────────────────────────────────────────────────────────
# A Vercel injeta este valor no header do cron. Vazio: a rota não existe (404).
# 32+ caracteres; gere com: openssl rand -hex 32
CRON_SECRET=

# ── Login atrás de proxy (opcional) ──────────────────────────────────────────
# Fora da Vercel, o nome do cabeçalho que o SEU proxy escreve com o IP do
# cliente (ex.: x-forwarded-for no nginx com proxy_add_x_forwarded_for). Vazio:
# a espera entre tentativas vale para todos juntos. Na Vercel, deixe vazio.
IP_HEADER=
